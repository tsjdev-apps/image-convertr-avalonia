<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:ImageConvertr.App.ViewModels"
		xmlns:models="using:ImageConvertr.Core.Models"
		xmlns:localization="using:ImageConvertr.App.Resources.Localization"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		d:DesignWidth="1120"
		d:DesignHeight="630"
		x:Class="ImageConvertr.App.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/AppIcon.ico"
		Title="{x:Static localization:Strings.Window_Title}"
		Width="1120"
		Height="630"
		MinWidth="900"
		MinHeight="560"
		Background="{DynamicResource AppBackgroundBrush}"
		CanResize="True">

	<Grid ColumnDefinitions="1.35*,1*"
		  ColumnSpacing="22"
		  Margin="14">
		<Border Classes="card">
			<Grid RowDefinitions="Auto,*,Auto"
				  RowSpacing="18">
				<StackPanel Grid.Row="0" Spacing="4">
					<TextBlock Classes="heading-large"
							   Text="{x:Static localization:Strings.Main_Title}" />
					<TextBlock Classes="body-text"
							   Text="{x:Static localization:Strings.Main_Description}"
							   TextWrapping="Wrap" />
				</StackPanel>

				<ScrollViewer Grid.Row="1"
							  HorizontalScrollBarVisibility="Disabled"
							  VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="16">
						<StackPanel Spacing="7">
							<TextBlock Classes="field-label"
									   Text="{x:Static localization:Strings.SourceFolder_Label}" />
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
								<TextBox Grid.Column="0"
										 IsReadOnly="True"
										 Text="{Binding ImageFolderPath}"
										 PlaceholderText="{x:Static localization:Strings.SourceFolder_Watermark}" />
								<Button Grid.Column="1"
										Command="{Binding SelectImageFolderCommand}"
										IsEnabled="{Binding CanEditInputs}"
										MinWidth="50"
										ToolTip.Tip="{x:Static localization:Strings.Browse_ToolTip}"
										Classes="Primary"
										Theme="{StaticResource SolidButton}">
									<PathIcon Width="18"
											  Height="18"
											  Data="M3 6H9L11 8H21V19H3Z" />
								</Button>
							</Grid>
						</StackPanel>

						<StackPanel Spacing="7">
							<TextBlock Classes="field-label"
									   Text="{x:Static localization:Strings.TargetFolder_Label}" />
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
								<TextBox Grid.Column="0"
										 IsReadOnly="True"
										 Text="{Binding OutputFolderPath}"
										 PlaceholderText="{x:Static localization:Strings.TargetFolder_Watermark}" />
								<Button Grid.Column="1"
										Command="{Binding SelectOutputFolderCommand}"
										IsEnabled="{Binding CanEditInputs}"
										MinWidth="50"
										ToolTip.Tip="{x:Static localization:Strings.Browse_ToolTip}"
										Classes="Primary"
										Theme="{StaticResource SolidButton}">
									<PathIcon Width="18"
											  Height="18"
											  Data="M3 6H9L11 8H21V19H3Z" />
								</Button>
							</Grid>
						</StackPanel>

						<Grid ColumnDefinitions="*,180" ColumnSpacing="14">
							<StackPanel Spacing="7">
								<TextBlock Classes="field-label"
										   Text="{x:Static localization:Strings.TargetFormat_Label}" />
								<ComboBox ItemsSource="{Binding OutputFormats}"
										  SelectedItem="{Binding SelectedOutputFormat}"
										  IsEnabled="{Binding CanEditInputs}"
										  HorizontalAlignment="Stretch">
									<ComboBox.ItemTemplate>
										<DataTemplate x:DataType="models:ImageOutputFormatOption">
											<TextBlock Text="{Binding DisplayName}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>

							<StackPanel Grid.Column="1" Spacing="7">
								<TextBlock Classes="field-label"
										   Text="{x:Static localization:Strings.ImageQuality_Label}" />
								<NumericUpDown ClipValueToMinMax="True"
											   ParsingNumberStyle="Integer"
											   FormatString="N0"
											   Value="{Binding ImageQuality}"
											   Increment="1"
											   Minimum="0"
											   Maximum="100"
											   IsEnabled="{Binding CanEditInputs}" />
							</StackPanel>
						</Grid>

						<TextBlock Classes="help-text"
								   Margin="0,-8,0,0"
								   Text="{x:Static localization:Strings.ImageQuality_Description}"
								   TextWrapping="Wrap" />

						<Border Classes="panel">
							<StackPanel Spacing="9">
								<CheckBox Content="{x:Static localization:Strings.OverwriteFiles_Label}"
										  IsEnabled="{Binding CanEditInputs}"
										  IsChecked="{Binding ShouldOverwriteExistingFiles}" />
								<TextBlock Classes="help-text"
										   Text="{x:Static localization:Strings.OverwriteFiles_Description}"
										   TextWrapping="Wrap" />
							</StackPanel>
						</Border>

						<TextBlock Classes="validation-text"
								   IsVisible="{Binding HasValidationMessage}"
								   Text="{Binding ValidationMessage}"
								   TextWrapping="Wrap" />
					</StackPanel>
				</ScrollViewer>

				<Button Grid.Row="2"
						Classes="Primary"
						Theme="{StaticResource SolidButton}"
						Command="{Binding ConvertImagesCommand}"
						Content="{Binding StartButtonText}"
						HorizontalAlignment="Stretch" />
			</Grid>
		</Border>

		<Border Grid.Column="1" Classes="card">
			<Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
				<TextBlock Grid.Row="0"
						   Classes="heading-medium"
						   Text="{x:Static localization:Strings.Progress_Title}" />

				<Border Grid.Row="1" Classes="progress-panel">
					<Grid RowDefinitions="Auto,Auto" RowSpacing="10">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock FontWeight="SemiBold"
									   Classes="accent"
									   Text="{Binding ProgressSummary}" />
							<TextBlock Grid.Column="1"
									   FontWeight="SemiBold"
									   Classes="accent"
									   Text="{Binding ProgressStateText}" />
						</Grid>
						<ProgressBar Grid.Row="1"
								 Height="10"
								 Maximum="100"
								 Value="{Binding ProgressPercentage}" />
					</Grid>
				</Border>

				<TextBlock Grid.Row="2"
						   Classes="section-label"
						   Text="{x:Static localization:Strings.Progress_HistoryTitle}" />

				<Grid Grid.Row="3">
					<TextBlock IsVisible="{Binding IsConversionHistoryEmpty}"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   Classes="body-text"
							   Text="{x:Static localization:Strings.Progress_NoFiles}" />

					<ListBox x:Name="ConversionHistoryListBox"
							 IsVisible="{Binding HasConversionHistory}"
							 ItemsSource="{Binding ConversionHistory}"
							 Background="Transparent"
							 BorderThickness="0"
							 Padding="0"
							 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							 ScrollViewer.VerticalScrollBarVisibility="Auto">
						<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
								<Setter Property="Padding" Value="0" />
								<Setter Property="Margin" Value="0" />
							</Style>
						</ListBox.Styles>
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:ConversionHistoryEntry">
								<Border Classes="history-entry"
										Classes.success="{Binding IsSuccessful}"
										Classes.skipped="{Binding IsSkipped}"
										Classes.failed="{Binding IsFailed}"
										Classes.summary="{Binding IsSummary}"
										ToolTip.Tip="{Binding SourceFileName}">
									<Grid ColumnDefinitions="20,*" ColumnSpacing="8">
										<TextBlock Classes="status-symbol"
												   Text="{Binding StatusSymbol}" />
										<StackPanel Grid.Column="1" Spacing="1">
											<TextBlock FontWeight="SemiBold"
													   Text="{Binding SourceFileName}"
													   TextTrimming="CharacterEllipsis"
													   MaxLines="1" />
											<TextBlock Classes="history-result"
													   Text="{Binding ResultText}"
													   TextWrapping="Wrap"
													   MaxLines="2"
													   TextTrimming="CharacterEllipsis" />
											<TextBlock Classes="history-meta"
													   Text="{Binding DetailText}"
													   TextTrimming="CharacterEllipsis"
													   MaxLines="1" />
											<TextBlock Classes="history-meta"
													   IsVisible="{Binding HasFileSizeText}"
													   Text="{Binding FileSizeText}" />
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</Window>
